{
  "manifest_version": 3,
  "name": "GUPTCHARA - AI Privacy Agent",
  "version": "1.0.0",
  "description": "GUPTCHARA: Zero-egress visual privacy engine running YOLO via WebGPU and Presidio PII filtering with live DOM redaction and autonomous VLM agent loop.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yolo-privacy-agent@sih.internal",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "<all_urls>",
    "*://*/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "GUPTCHARA - AI Privacy Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "sidebar_action": {
    "default_title": "GUPTCHARA - AI Privacy Agent",
    "default_panel": "sidepanel/sidepanel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "scripts": ["background/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["engine/pii_detector.js", "engine/ocr_detector.js", "content/content.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "models/*", "engine/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
